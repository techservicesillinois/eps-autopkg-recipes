<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Description</key>
    <string>Download the latest version of Slack and imports it into Munki.</string>
    <key>Identifier</key>
    <string>com.github.eps-autopkg-recipes.munki.slack</string>
    <key>Input</key>
    <dict>
        <key>MUNKI_REPO_SUBDIR</key>
        <string>global_free/slack</string>
        <key>NAME</key>
        <string>slack</string>
    	<key>pkginfo</key>
    	<dict>
    		<key>catalogs</key>
    		<array>
    			<string>global_free_raw-edit</string>
    		</array>
            <key>category</key>
            <string>Web, Cloud</string>
            <key>developer</key>
            <string>Salesforce</string>
            <key>display_name</key>
            <string>Slack</string>
    		<key>description</key>
    		<string>Slack is a popular team collaboration and communication platform used by businesses to facilitate teamwork and information sharing. It provides features like channels for organized conversations, direct messaging for private chats, and integrations with various apps and tools.</string>
    		<key>name</key>
    		<string>%NAME%</string>
            <key>display_name</key>
            <string>%NAME%</string>
    		<key>unattended_install</key>
    		<true/>
    	</dict>
    </dict>
    <key>MinimumVersion</key>
    <string>2.7</string>
    <key>ParentRecipe</key>
    <string>com.github.rtrouton.pkg.SlackUniversal</string>
    <key>Process</key>
    <array>
        <dict>
            <key>Arguments</key>
            <dict>
                <key>pkg_path</key>
                <string>%pkg_path%</string>
                <key>repo_subdirectory</key>
                <string>%MUNKI_REPO_SUBDIR%</string>
            </dict>
            <key>Processor</key>
            <string>MunkiImporter</string>
        </dict>
    </array>
</dict>
</plist>
