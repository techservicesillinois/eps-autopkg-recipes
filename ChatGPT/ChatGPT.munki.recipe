<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Description</key>
	<string>Imports ChatGPT app into Munki.</string>
	<key>Identifier</key>
	<string>com.github.eps-autopkg-recipes.munki.ChatGPT</string>
	<key>Input</key>
	<dict>
		<key>MUNKI_CATEGORY</key>
		<string>AI</string>
		<key>MUNKI_REPO_SUBDIR</key>
		<string>global_free/chatgpt</string>
		<key>NAME</key>
		<string>chatgpt</string>
		<key>pkginfo</key>
		<dict>
			<key>catalogs</key>
			<array>
				<string>global_free_raw</string>
			</array>
			<key>category</key>
			<string>%MUNKI_CATEGORY%</string>
			<key>description</key>
			<string>A dedicated application for accessing ChatGPT, offering features like voice conversations, integration with your computer's system, and a more streamlined user experience compared to the web version. It aims to provide a more convenient and efficient way to interact with the AI.</string>
			<key>developer</key>
			<string>OpenAI</string>
			<key>display_name</key>
			<string>ChatGPT Desktop</string>
			<key>icon_name</key>
			<string>global/chatgpt.png</string>
			<key>name</key>
			<string>%NAME%</string>
			<key>supported_architectures</key>
			<array>
				<string>arm64</string>
			</array>
			<key>unattended_install</key>
			<true/>
		</dict>
	</dict>
	<key>ParentRecipe</key>
	<string>com.github.eps-autopkg-recipes.jamf.ChatGPT.download</string>
	<key>Process</key>
	<array>
		<dict>
			<key>Arguments</key>
			<dict>
				<key>pkg_path</key>
				<string>%pathname%</string>
				<key>repo_subdirectory</key>
				<string>%MUNKI_REPO_SUBDIR%</string>
			</dict>
			<key>Processor</key>
			<string>MunkiImporter</string>
		</dict>
	</array>
</dict>
</plist>
