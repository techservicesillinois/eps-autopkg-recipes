<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Description</key>
    <string>Builds the Aquamacs package.</string>
    <key>Identifier</key>
    <string>com.github.eps-autopkg-recipes.jamf.pkg.Aquamacs</string>
    <key>Input</key>
    <dict>
        <key>NAME</key>
        <string>Aquamacs</string>
    </dict>
    <key>ParentRecipe</key>
    <string>com.github.hansen-m.download.aquamacs</string>
    <key>MinimumVersion</key>
    <string>1.0</string>
    <key>Process</key>
    <array>
        <dict>
            <key>Arguments</key>
            <dict>
                <key>app_path</key>
                <string>%pathname%/Aquamacs.app</string>
                <key>bundleid</key>
                <string>org.gnu.Aquamacs</string>
            </dict>
            <key>Processor</key>
            <string>AppPkgCreator</string>
        </dict>
    </array>
</dict>
</plist>
