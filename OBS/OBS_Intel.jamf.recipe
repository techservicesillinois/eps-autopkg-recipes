<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Identifier</key>
	<string>com.github.eps-autopkg-recipes.jamf.OBS_Intel</string>
	<key>Input</key>
	<dict>
		<key>ARCH</key>
		<string>intel</string>
		<key>CATEGORY</key>
		<string>Media and Design</string>
		<key>GROUP_NAME</key>
		<string>Global - OBS - Testing - Intel</string>
		<key>GROUP_TEMPLATE</key>
		<string>JamfSmartGroupTemplate.xml</string>
		<key>NAME</key>
		<string>OBS_Intel</string>
		<key>POLICY_CATEGORY</key>
		<string>Software Testing (AutoPkg)</string>
		<key>POLICY_NAME</key>
		<string>Global - OBS - Testing - Intel</string>
		<key>POLICY_TEMPLATE</key>
		<string>JamfPolicyTemplate.xml</string>
		<key>RE_PATTERN</key>
		<string>href="(.*?%ARCH%.dmg)"</string>
		<key>SEARCH_URL</key>
		<string>https://obsproject.com/download</string>
		<key>SELF_SERVICE_DESCRIPTION</key>
		<string>A free and open source software for video recording and live streaming.</string>
		<key>SELF_SERVICE_DISPLAY_NAME</key>
		<string>OBS</string>
		<key>SELF_SERVICE_ICON</key>
		<string>OBS.png</string>
		<key>TESTING_GROUP_NAME</key>
		<string>Global - Software Testing - Update</string>
		<key>UPDATE_PREDICATE</key>
		<string>pkg_uploaded == False</string>
	</dict>
	<key>MinimumVersion</key>
	<string>2.0</string>
	<key>ParentRecipe</key>
	<string>com.github.nstrauss.pkg.OBS</string>
	<key>Process</key>
		<array>
			<dict>
				<key>Arguments</key>
				<dict>
					<key>category_name</key>
					<string>%CATEGORY%</string>
				</dict>
				<key>Processor</key>
				<string>com.github.grahampugh.jamf-upload.processors/JamfCategoryUploader</string>
			</dict>
			<dict>
				<key>Arguments</key>
				<dict>
					<key>category_name</key>
					<string>%POLICY_CATEGORY%</string>
				</dict>
				<key>Processor</key>
				<string>com.github.grahampugh.jamf-upload.processors/JamfCategoryUploader</string>
			</dict>
			<dict>
				<key>Arguments</key>
				<dict>
					<key>pkg_category</key>
					<string>%CATEGORY%</string>
				</dict>
				<key>Processor</key>
				<string>com.github.grahampugh.jamf-upload.processors/JamfPackageUploader</string>
			</dict>
			<dict>
				<key>Arguments</key>
				<dict>
					<key>predicate</key>
					<string>%UPDATE_PREDICATE%</string>
				</dict>
				<key>Processor</key>
				<string>StopProcessingIf</string>
			</dict>
			<dict>
				<key>Arguments</key>
				<dict>
					<key>computergroup_name</key>
					<string>%GROUP_NAME%</string>
					<key>computergroup_template</key>
					<string>%GROUP_TEMPLATE%</string>
					<key>replace_group</key>
					<string>True</string>
				</dict>
				<key>Processor</key>
				<string>com.github.grahampugh.jamf-upload.processors/JamfComputerGroupUploader</string>
			</dict>
			<dict>
				<key>Arguments</key>
				<dict>
					<key>icon</key>
					<string>%SELF_SERVICE_ICON%</string>
					<key>policy_name</key>
					<string>%POLICY_NAME%</string>
					<key>policy_template</key>
					<string>%POLICY_TEMPLATE%</string>
					<key>replace_policy</key>
					<string>True</string>
				</dict>
				<key>Processor</key>
				<string>com.github.grahampugh.jamf-upload.processors/JamfPolicyUploader</string>
			</dict>
			<dict>
    			<key>Processor</key>
   				<string>PathDeleter</string>
    			<key>Arguments</key>
    			<dict>
        			<key>path_list</key>
        			<array>
           	 			<string>%pkg_path%</string>
           	 			<strung>%pathname%</string>
        			</array>
    			</dict>
			</dict>
		</array>
</dict>
</plist>
