<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Description</key>
    <string>Builds the Pure Data package.</string>
    <key>Identifier</key>
    <string>com.github.eps-autopkg-recipes.jamf.pkg.PureData</string>
    <key>Input</key>
    <dict>
        <key>NAME</key>
        <string>Pure Data</string>
    </dict>
    <key>ParentRecipe</key>
    <string>com.github.eps-autopkg-recipes.jamf.download.PureData</string>
    <key>MinimumVersion</key>
    <string>1.0</string>
    <key>Process</key>
    <array>
 		<dict>
        	<key>Comment</key>
        	<string>Get version from the app</string>
     	   	<key>Processor</key>
      	  	<string>Versioner</string>
        	<key>Arguments</key>
        	<dict>
           		<key>input_plist_path</key>
            	<string>%pkgroot%/Pd.app/Contents/Info.plist</string>
            	<key>plist_version_key</key>
            	<string>CFBundleShortVersionString</string>
        	</dict>
    	</dict>
    	<dict>
        	<key>Processor</key>
        	<string>PkgCreator</string>
        	<key>Arguments</key>
        	<dict>
           	 <key>pkg_request</key>
            	<dict>
                	<key>pkgname</key>
                	<string>PureData-%version%</string>
                	<key>version</key>
                	<string>%version%</string>
                	<key>id</key>
                	<string>org.puredata.pd.pd-gui</string>
                	<key>options</key>
                	<string>purge_ds_store</string>
                	<key>chown</key>
                    <array>
                        <dict>
                            <key>path</key>
                            <string>Applications</string>
                            <key>user</key>
                            <string>root</string>
                            <key>group</key>
                            <string>admin</string>
                        </dict>
                    </array>
            	</dict>
        	</dict>
        </dict>
    </array>
</dict>
</plist>
